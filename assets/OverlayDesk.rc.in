// Version resource, generated by CMake from this template so the version lives in exactly
// one place (project(... VERSION ...) in CMakeLists.txt) rather than being retyped here and
// drifting.
//
// Without this the executable shows no product name or version in Explorer's Details tab,
// which for a portable download is the only place a user can check what they have.

#include <winver.h>

// The application icon. Id 1 rather than a name because Explorer takes the numerically lowest
// icon resource as the file's icon, and 1 is the lowest there is - a named resource would show
// the correct icon in the window and the wrong one (none) in the shell.
//
// Regenerate assets/OverlayDesk.ico with scripts/make-icon.ps1; the build only embeds it.
1 ICON "@OVERLAYDESK_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS      VS_FF_DEBUG
#else
    FILEFLAGS      0x0L
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = English (United States), 04b0 = Unicode. The string values themselves are
        // what Explorer shows; the language only tells it how to interpret them.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@OVERLAYDESK_COMPANY@"
            VALUE "FileDescription",  "@PROJECT_DESCRIPTION@"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "OverlayDesk"
            VALUE "LegalCopyright",   "@OVERLAYDESK_COPYRIGHT@"
            VALUE "OriginalFilename", "OverlayDesk.exe"
            VALUE "ProductName",      "Overlay Desk"
            VALUE "ProductVersion",   "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
