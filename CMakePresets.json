{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs",
      "displayName": "Visual Studio 2026 (x64, multi-config)",
      "description": "Default configure preset. The VS generator locates the MSVC toolset on its own, so no vcvars shell is required.",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "ninja",
      "displayName": "Ninja Release (requires a vcvars64 developer shell)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "vs", "configuration": "Debug" },
    { "name": "release", "configurePreset": "vs", "configuration": "Release" },
    { "name": "ninja",   "configurePreset": "ninja" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "vs",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "vs",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
